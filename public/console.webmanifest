{
  "id": "/console",
  "name": "MIRVA for stores",
  "short_name": "MIRVA Store",
  "description": "Your store's MIRVA: what shoppers tried, kept and bought, your catalogue, your mirrors and your limits.",
  "start_url": "/console?source=app",
