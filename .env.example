# The Decart key stays on this machine. It is never sent to the browser.
DECART_API_KEY=dct_your_key_here

# Live try-on: the cap on one session, and how long without a tap before it pauses (seconds).
MIRVA_SESSION_SECONDS=180
MIRVA_IDLE_SECONDS=75

# Spending guards across the whole machine, an hour.
MIRVA_SHOTS_PER_HOUR=60
MIRVA_SESSIONS_PER_HOUR=60

PORT=4310

# --- only needed when MIRVA leaves this laptop -------------------------------
# The real address. Turns on secure cookies and makes links and QR codes point here.
# MIRVA_PUBLIC_ORIGIN=https://mirva.example
# 1 lets anyone who can reach the page start a paid try-on. Leave unset online (it defaults to off there).
# MIRVA_OPEN_MIRROR=0
# Behind a TLS proxy: listen on all interfaces and trust its forwarded address.
# MIRVA_LISTEN=0.0.0.0
# MIRVA_TRUST_PROXY=1
# test = the pretend checkout for MIRVA Private. off = no checkout at all.
# MIRVA_PAYMENTS=off
# The founder's sign-in email, used the first time the server starts.
# MIRVA_FOUNDER_EMAIL=you@example.com
# Where the database and portraits live. Default: .data in this folder.
# MIRVA_DATA=
